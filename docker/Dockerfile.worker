# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

FROM base AS pruner
RUN pnpm add -g turbo@2
COPY . .
RUN turbo prune worker --docker

FROM base AS installer
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=worker...
# NOTE: `pnpm prune --prod` is skipped here — on pnpm 10 it strips the
# top-level node_modules symlinks (including ones prod deps like dotenv
# need) out from under this pruned/symlinked workspace layout, leaving the
# packages orphaned in .pnpm and breaking `require()` at runtime. See
# docs/03-docker-monorepo.md for the measured image-size cost of skipping it.

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=installer /app .
USER node
CMD ["node", "apps/worker/dist/main.js"]
